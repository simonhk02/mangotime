generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Auth (task 1.1): passwordHash + sessions
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  displayName  String
  avatarUrl    String?
  birthdate String? // "MM-dd" 生日（成員生日自動上曆）
  digestTime  String? // "HH:MM" 今日行程推送時間（null = 08:00）
  premiumUntil DateTime? // Premium 到期（null = 免費版）
  passwordHash String? // social-only 帳可以冇密碼
  createdAt    DateTime  @default(now())
  sessions     Session[]
  memberships  CalendarMember[] @relation("Memberships")
  createdCalendars Calendar[]   @relation("CreatedCalendars")
  createdEvents    Event[]      @relation("CreatedEvents")
  comments         Comment[]
  memos            Memo[]
  memoComments     MemoComment[]
  todoLists        TodoList[]
  photos           Photo[]
  apiKeys          ApiKey[]
  attachments      Attachment[]
  socialAccounts   SocialAccount[]
  devices          Device[]
  rsvps     EventParticipant[]
}

// Social auth（Apple / Google）：一個 user 可以 link 多個 provider
model SocialAccount {
  id          String   @id @default(cuid())
  provider    String   // "apple" | "google"
  providerSub String   // provider 嘅穩定 user id（JWT sub）
  email       String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([provider, providerSub])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// Task 1.2 — Calendar + membership (multi-tenant from day 1: every query is membership-scoped)
model Calendar {
  id            String           @id @default(cuid())
  name          String
  coverImageUrl String?
  creatorId     String
  creator       User             @relation("CreatedCalendars", fields: [creatorId], references: [id])
  createdAt     DateTime         @default(now())
  members       CalendarMember[]
  children   ChildMember[]
  events        Event[]
  invites       Invite[]
  memos         Memo[]
  todoLists     TodoList[]
  photos        Photo[]
  externals     ExternalCalendar[]
  webhooks      Webhook[]
  publicSlug  String?  @unique // 5.2 公開唯讀 link（null = 未開）
}

// Task 1.3 — Invite link（一個行事曆可以有多條，revokedAt 標記失效）
model Invite {
  id         String    @id @default(cuid())
  calendarId String
  calendar   Calendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  code       String    @unique
  creatorId  String
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([calendarId])
}

model CalendarMember {
  id         String   @id @default(cuid())
  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("Memberships", fields: [userId], references: [id], onDelete: Cascade)
  role       String   // "creator" | "member"
  color      String?  // 每成員顏色（emerald/blue/red/purple/bright-orange）
  lastSeenAt DateTime? // 「對方何時查看過」
  sortOrder  Int      @default(0)   // 行事曆排列次序
  notify     Boolean  @default(true) // per-calendar 推送開關
  createdAt  DateTime @default(now())

  @@unique([calendarId, userId])
}

// Durable event outbox — webhook dispatcher lands in 4.2; events are captured from day 1.
model OutboxEvent {
  id          String    @id @default(cuid())
  type        String    // e.g. "calendar.created"
  aggregateId String    // e.g. calendar id
  payload     String    // JSON
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
}

// Task 1.4 — Event
model Event {
  id         String   @id @default(cuid())
  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  title      String
  allDay     Boolean  @default(false)
  startsAt   DateTime
  endsAt     DateTime?
  repeatRule String   @default("none") // none|daily|weekly|monthly|yearly
  remindMin  Int?     // minutes before
  labelColor String?  // e.g. "emerald"
  note       String?
  url        String?
  location   String?
  creatorId  String
  creator    User     @relation("CreatedEvents", fields: [creatorId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  comments   Comment[]
  attachments Attachment[]
  participants EventParticipant[]
  members    EventMember[]
  pinned     Boolean @default(false)

  @@index([calendarId, startsAt])
}

model EventMember {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String

  @@unique([eventId, userId])
}

model EventParticipant {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   // going | declined
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

// Task 2.1 — Event comment（活動留言 chat）
model Comment {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
}

// Task 2.2 — Memo（備忘錄）+ 留言
model Memo {
  id         String        @id @default(cuid())
  calendarId String
  calendar   Calendar      @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  title      String
  body       String        @default("")
  labelColor String?
  creatorId  String
  creator    User          @relation(fields: [creatorId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  comments   MemoComment[]

  @@index([calendarId, updatedAt])
}

model MemoComment {
  id        String   @id @default(cuid())
  memoId    String
  memo      Memo     @relation(fields: [memoId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([memoId, createdAt])
}

// Task 2.3 — Todo list（待辦清單）+ items
model TodoList {
  id         String     @id @default(cuid())
  calendarId String
  calendar   Calendar   @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  title      String
  creatorId  String
  creator    User       @relation(fields: [creatorId], references: [id])
  createdAt  DateTime   @default(now())
  items      TodoItem[]

  @@index([calendarId])
}

model TodoItem {
  id        String   @id @default(cuid())
  listId    String
  list      TodoList @relation(fields: [listId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  doneById  String?
  createdAt DateTime @default(now())

  @@index([listId, createdAt])
}

// Task 2.4 — Photo（相簿，檔案存 /data/uploads，cuid 檔名）
model Photo {
  id         String   @id @default(cuid())
  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  filename   String   // uploads/<filename>
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  @@index([calendarId, createdAt])
}

// Task 4.1 — API key（agent 用長期 key；只存 hash）
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  prefix     String    // 顯示用：mt_xxxx…
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}

// Task 5.1 — External calendar 訂閱（.ics URL，cache 咗啲活動）
model ExternalCalendar {
  id            String    @id @default(cuid())
  calendarId    String
  calendar      Calendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  url           String
  name          String
  cachedEvents  String?   // JSON array of IcsEvent
  lastFetchedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([calendarId])
}

// Task 5.4 — Event attachment（活動附件：相/PDF 釘落活動）
model Attachment {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  filename   String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  @@index([eventId])
}

// APNs 推送：每部裝置一個 token
model Device {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("ios")
  createdAt DateTime @default(now())

  @@index([userId])
}

// Task 4.2 — Webhook 訂閱（每個行事曆可有多條；dispatcher 讀 OutboxEvent 派遞）
model Webhook {
  id         String    @id @default(cuid())
  calendarId String
  calendar   Calendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  url        String
  secret     String    // HMAC 簽名用
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([calendarId])
}

model ChildMember {
  id         String   @id @default(cuid())
  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  name       String
  birthdate  String?  // "MM-dd"
  createdAt  DateTime @default(now())
}

model PublicLike {
  id         String   @id @default(cuid())
  publicSlug String
  userId     String
  createdAt  DateTime @default(now())

  @@unique([publicSlug, userId])
  @@index([userId])
}
